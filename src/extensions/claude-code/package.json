{
  "name": "pi-claude-code",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi provider for Claude Pro or Max models through the Claude Code CLI",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "claude-code"
  ],
  "pi": {

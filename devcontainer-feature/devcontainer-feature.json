{
  "name": "Pi",
  "id": "pi",
  "version": "1.0.0",
  "description": "Installs Pi with Juan's portable agent configuration.",
  "documentationURL": "https://github.com/jjlinares/pi",
  "keywords": ["pi", "agent", "ai", "coding"],
  "options": {
    "piVersion": {
      "type": "string",
      "default": "latest",
      "proposals": ["latest"],
      "description": "Version of @earendil-works/pi-coding-agent to install."
    },
    "piAgentDir": {
      "type": "string",
      "default": "~/.pi/agent",
      "proposals": ["~/.pi/agent", "/workspace/.pi/agent"],
      "description": "Pi agent directory. Use an absolute path or a path beginning with ~/."
    }
  },
  "dependsOn": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "nodeGypDependencies": false,
      "npmVersion": "none",
      "pnpmVersion": "none"
    }
  },
  "postStartCommand": "/usr/local/share/pi-feature/post-start.sh"
}
